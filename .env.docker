# ==============================================================================
# Full-Stack RAG Pipeline - Docker Compose Configuration
# ==============================================================================

# --- PostgreSQL Container ---
POSTGRES_DB=rag_gateway
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_PORT=5432

# --- Python FastAPI RAG Service ---
RAG_SERVICE_PORT=8000
RAG_VECTOR_BACKEND=chroma
RAG_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_MODEL_LOCAL_FILES_ONLY=false
RAG_LLM_PROVIDER=extractive
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# --- Spring Boot API Gateway ---
GATEWAY_PORT=8080
JWT_SECRET=super-secret-jwt-key-for-rag-gateway-at-least-32-chars
JWT_TOKEN_TTL=1h
JWT_DEMO_USERNAME=demo
JWT_DEMO_PASSWORD=demo123
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_TOKENS=30
RATE_LIMIT_REFILL_PERIOD=1m

# --- Next.js Frontend ---
FRONTEND_PORT=3000
