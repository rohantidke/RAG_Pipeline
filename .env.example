# ==============================================================================
# Full-Stack RAG Pipeline - Local Environment Configuration
# ==============================================================================

# --- PostgreSQL Database (Metadata Store) ---
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/rag_gateway
DATABASE_USERNAME=rag
DATABASE_PASSWORD=rag

# --- Spring Boot API Gateway ---
RAG_SERVICE_BASE_URL=http://127.0.0.1:8000
JWT_ISSUER=rag-spring-gateway
JWT_SECRET=super-secret-jwt-key-for-rag-gateway-at-least-32-chars
JWT_TOKEN_TTL=1h
JWT_DEMO_USERNAME=demo
JWT_DEMO_PASSWORD=demo123
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_TOKENS=30
RATE_LIMIT_REFILL_PERIOD=1m

# --- Python FastAPI RAG Service ---
RAG_INDEX_PATH=text_chunks_and_embeddings_df.csv
RAG_DOCUMENTS_DIR=documents
RAG_DOCUMENTS_REGISTRY=documents/registry.json
RAG_VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=rag_chunks
RAG_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_MODEL_LOCAL_FILES_ONLY=false
RAG_LLM_PROVIDER=extractive
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
RAG_REQUEST_TIMEOUT_SECONDS=120
RAG_MAX_UPLOAD_BYTES=52428800
RAG_MAX_EXTRACTED_CHARS=2000000

# --- Next.js Frontend ---
SPRING_GATEWAY_URL=http://127.0.0.1:8080
