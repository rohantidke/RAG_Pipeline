# ==============================================================================
# Spring Boot API Gateway - Environment Configuration Example
# ==============================================================================

DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/rag_gateway
DATABASE_USERNAME=rag
DATABASE_PASSWORD=rag

RAG_SERVICE_BASE_URL=http://127.0.0.1:8000
RAG_SERVICE_TIMEOUT=60s

JWT_ISSUER=rag-spring-gateway
JWT_SECRET=super-secret-jwt-key-for-rag-gateway-at-least-32-chars
JWT_TOKEN_TTL=1h
JWT_DEMO_USERNAME=demo
JWT_DEMO_PASSWORD=demo123
JWT_SEED_DEMO_USER=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_TOKENS=30
RATE_LIMIT_REFILL_PERIOD=1m

UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=50MB
